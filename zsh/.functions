# Global functions
path () {
  echo "$PATH" | tr ':' '\n'
}

# Example: port 3000
port () {
  lsof -i"TCP:$1" -sTCP:LISTEN -n -P
}

fix () {
  if [[ -z "$*" ]]; then
    echo "usage: fix <url or description>" >&2
    return 1
  fi

  claude "Do $* then /opening-pull-requests" -w
}

# Example: rebase archlet/award-webhook
rebase () {
  local branch=$1

  if [[ -z "$branch" ]]; then
    echo 'usage: rebase <branch>' >&2
    return 1
  fi

  claude "Rebase $branch onto origin/develop, then push it" -w
}

# Example: yarn_run dev
yarn_run () {
  yarn install --silent && yarn "${1:-dev}"
}

# Git functions
clone () {
  basename=$(basename "$1" .git)

  git clone "$1" && cd "$basename" || return
}

# Check out a branch and pull it. Defaults to the main branch.
# Example: gcpl develop
gcpl () {
  git checkout "${1:-$(git_main_branch)}" && git pull
}

# Clean merged branches
sweep () {
  git branch --merged "$(git_main_branch)" | grep -v "$(git_main_branch)$" | xargs git branch -d && git remote prune origin
}

# Ruby functions
# Example: rao Style/StringLiterals
rao () {
  if [[ -z "$1" ]]; then
    echo "usage: rao <cop>" >&2
    return 1
  fi

  bundle exec rubocop -a --only "$1"
}

# Example: rAo Style/StringLiterals
rAo () {
  if [[ -z "$1" ]]; then
    echo "usage: rAo <cop>" >&2
    return 1
  fi

  bundle exec rubocop -A --only "$1"
}

# Run the specs for the files you changed. Extra arguments go to rspec.
# Example: mrspec --fail-fast
mrspec () {
  local specs
  specs=$(git ls-files --modified --others spec spec_integration)

  if [[ -z "$specs" ]]; then
    echo 'no modified or untracked spec files' >&2
    return 1
  fi

  bundle exec rspec ${=specs} "$@"
}

# Update the rubocop gems together: an extension pins the rubocop version it needs.
update_rubocop () {
  bundle update rubocop rubocop-capybara rubocop-factory_bot rubocop-performance \
    rubocop-rails rubocop-rspec rubocop-rspec_rails
}
