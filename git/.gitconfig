[user]
  name = Guillaume Briday
  email = guillaumebriday@gmail.com
[init]
  defaultBranch = main
[core]
  editor = vim
  excludesfile = ~/.gitignore_global
  autocrlf = input
  ignorecase = false
  untrackedCache = true
  trustctime = false
[pull]
  rebase = true
[push]
  default = current
  autoSetupRemote = true
[merge]
  ff = false
[color]
  ui = true
[pager]
  branch = false
  diff = less -+FX
[commit]
  verbose = true
[diff]
  noprefix = true
[protocol]
  version = 2
[rebase]
  autoStash = true
[alias]
  ac = !git add . && git commit -m
  amend = commit --amend --no-edit
  edit = commit --amend --only

  # Unlock and remove the worktree holding a branch, so it can be checked out again
  wtrm = "!f() { \
    force=''; \
    if [ \"$1\" = '-f' ] || [ \"$1\" = '--force' ]; then force='--force'; shift; fi; \
    branch=\"${1:?usage: git wtrm [-f] <branch>}\"; \
    git worktree prune; \
    path=$(git worktree list --porcelain | awk -v ref=\"refs/heads/$branch\" '/^worktree /{p=substr($0, 10)} /^branch /{if (substr($0, 8) == ref) {print p; exit}}'); \
    if [ -n \"$path\" ]; then \
      git worktree unlock \"$path\" 2>/dev/null; \
      git worktree remove $force \"$path\" || { echo \"Discard that work with: git wtrm -f $branch\"; exit 1; }; \
      echo \"Removed worktree $path\"; \
    else \
      echo \"No worktree registered for $branch\"; \
    fi; \
    git checkout \"$branch\"; \
  }; f"

  # Serve local repo. http://coderwall.com/p/eybtga
  # Then other can access via `git clone git://#{YOUR_IP_ADDRESS}/
  serve = !git daemon --reuseaddr --verbose  --base-path=. --export-all ./.git

  # List contributors with number of commits
  contributors = shortlog --summary --numbered --no-merges
